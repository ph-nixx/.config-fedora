/* Matches ~/.config/polybar/config.ini (LightDM login panel colors) */
* {
    bg:        #353535;
    bg-alt:    #2b2b2b;
    fg:        #eeeeec;
    dim:       #919190;
    select:    #4A4A4A;
    select-fg: #ffffff;
    urgent:    #e01b24;
    border-c:  #4A4A4A;

    background-color: transparent;
    text-color:       @fg;
    margin:  0;
    padding: 0;
    spacing: 0;
}

window {
    width:            600px;
    background-color: @bg;
    border:           2px;
    border-color:     @border-c;
    border-radius:    0;
}

mainbox {
    padding:  12px;
    children: [ inputbar, listview ];
}

inputbar {
    padding:          8px 10px;
    spacing:          10px;
    background-color: @bg-alt;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @dim;
}

entry {
    placeholder:       "Search";
    placeholder-color: @dim;
    cursor:            text;
}

listview {
    lines:        8;
    columns:      1;
    fixed-height: true;
    scrollbar:    false;
    margin:       10px 0 0 0;
    spacing:      2px;
}

element {
    padding:  6px 10px;
    spacing:  10px;
    cursor:   pointer;
}

element normal.normal, element alternate.normal {
    text-color: @fg;
}

element selected.normal {
    background-color: @select;
    text-color:       @select-fg;
}

element normal.urgent, element alternate.urgent {
    text-color: @urgent;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @select-fg;
}

element normal.active, element alternate.active {
    text-color: @select-fg;
}

element selected.active {
    background-color: @select;
    text-color:       @select-fg;
}

element-icon {
    size:           20px;
    vertical-align: 0.5;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
}

message {
    margin:           10px 0 0 0;
    padding:          8px 10px;
    background-color: @bg-alt;
}

textbox {
    text-color: @fg;
}
